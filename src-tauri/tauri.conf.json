{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Utilify",
  "version": "0.2.1",
  "identifier": "com.utilify.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Utilify",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/pmv1051/utilify/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MDdDOEQyNEU5MENGOTgKUldTWXo1Qk8wc2dIcC9uWG9ZNm5wSjBTOTZxVnBIaUhON1B1VHBJNzNVdm5NWS9LSWxKY1liMG0K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Spotify playlist utilities",
    "longDescription": "Shadow playlist randomizer, bench, duplicate scanner, diff, merge, discography builder, playlist editor and export/import for Spotify. Bring your own Spotify Client ID.",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
